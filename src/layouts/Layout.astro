---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Skeleton from '../components/Skeleton.astro';
import { site } from '../data/site';
import { absoluteUrl, clientCopy, languageNames, locales, routePath, t, type Locale } from '../lib/i18n';
interface Props { locale: Locale; title?: string; description?: string; page?: string; noindex?: boolean }
const { locale, title = t(locale, 'my-name'), description = t(locale, 'site-description'), page = '', noindex = false } = Astro.props;
const canonical = absoluteUrl(noindex ? `${site.base}/404.html` : routePath(locale, page));
const ogLocales = { en: 'en_US', id: 'id_ID', ja: 'ja_JP' };
const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={locale} data-home={!page && !noindex ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafafa" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {!noindex && locales.map(language => <link rel="alternate" hreflang={language} href={absoluteUrl(routePath(language, page))} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={absoluteUrl(routePath('en', page))} />}
    <link rel="icon" type="image/svg+xml" href={`${site.base}/favicon.svg`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${site.base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${site.base}/sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales.filter(language => language !== locale).map(language => <meta property="og:locale:alternate" content={ogLocales[language]} />)}
    <meta property="og:image" content={absoluteUrl(`${site.base}/social-preview.png`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${t(locale, 'my-name')} — ${t(locale, 'site-description')}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(`${site.base}/social-preview.png`)} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        const dark = theme === 'dark' || (theme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.querySelector('meta[name="theme-color"]').setAttribute('content', dark ? '#0a0a0a' : '#fafafa');

        // Capture even cached images before the application module downloads.
        const settleMedia = (image, failed = false) => {
          if (!(image instanceof HTMLImageElement)) return;
          const frame = image.closest('.media-frame');
          if (!frame) return;
          const finish = error => {
            frame.dataset.mediaState = error ? 'error' : 'ready';
            frame.setAttribute('aria-busy', 'false');
          };
          if (failed) finish(true);
          else image.decode().then(() => finish(false), () => finish(true));
        };
        document.addEventListener('load', event => settleMedia(event.target), true);
        document.addEventListener('error', event => settleMedia(event.target, true), true);

        // Restore before showing a refreshed/returning page, rather than painting its top first.
        let top;
        const navigation = performance.getEntriesByType('navigation')[0];
        const positionKey = `portfolio-position:${location.pathname}`;
        if (navigation?.type === 'reload' || navigation?.type === 'back_forward') {
          top = history.state?.portfolioScroll;
          try { if (top === undefined && sessionStorage.getItem(positionKey) !== null) top = Number(sessionStorage.getItem(positionKey)); } catch {}
        }
        const key = `portfolio-scroll:${root.lang}`;
        if (root.hasAttribute('data-home')) {
          try {
            if (top === undefined && sessionStorage.getItem(key) !== null) top = Number(sessionStorage.getItem(key));
            sessionStorage.removeItem(key);
          } catch {}
        }
        try { history.scrollRestoration = 'manual'; } catch {}
        if (Number.isFinite(top) && top > 0 && !location.hash) {
          root.classList.add('restoring-scroll');
          root.dataset.restoreScroll = String(top);
          let restored = false;
          const restore = () => {
            if (restored) return;
            restored = true;
            scrollTo({ top, behavior: 'instant' });
            root.classList.remove('restoring-scroll');
          };
          document.addEventListener('DOMContentLoaded', restore, { once: true });
          window.addEventListener('pageshow', restore, { once: true });
        }
        const savePosition = () => {
          if (root.classList.contains('restoring-scroll')) return;
          try { sessionStorage.setItem(positionKey, String(scrollY)); } catch {}
          try { history.replaceState({ ...history.state, portfolioScroll: scrollY }, ''); } catch {}
        };
        let lastSave = 0, saveTimer;
        window.addEventListener('scroll', () => {
          clearTimeout(saveTimer);
          if (performance.now() - lastSave > 100) { savePosition(); lastSave = performance.now(); }
          else saveTimer = setTimeout(savePosition, 100);
        }, { passive: true });
        window.addEventListener('pagehide', savePosition);
        document.addEventListener('visibilitychange', () => { if (document.hidden) savePosition(); });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(locale, 'skip-content')}</a>
    <header class="site-header">
      {page && <a href={routePath(locale)} class="back-link control" aria-label={t(locale, 'back-home')}><Icon name="back" size={18} /><span class="back-full">{t(locale, 'back-home').replace(/^←\s*/, '')}</span><span class="back-short">{t(locale, 'back-short')}</span></a>}
      <div class="floating-controls">
        <button id="term-trigger" class="control" type="button" aria-label={t(locale, 'open-terminal')} aria-haspopup="dialog" aria-controls="terminal-dialog" hidden><span class="toggle-text">{t(locale, 'nav-term')}</span><Icon name="terminal" /></button>
        <details class="lang-dropdown" id="lang-dropdown">
          <summary id="lang-toggle" class="control" aria-label={`${t(locale, 'language-label')} (${languageNames[locale]})`}><span class="locale-code">{locale.toUpperCase()}</span><Icon name="globe" /></summary>
          <nav class="lang-menu" aria-label={t(locale, 'language-label')}>
            {locales.map(language => <a class="lang-option" href={routePath(language, noindex ? '' : page)} lang={language} hreflang={language} aria-current={language === locale ? 'page' : undefined}>{languageNames[language]}</a>)}
          </nav>
        </details>
        <button id="theme-toggle" class="control" type="button" aria-label={t(locale, 'appearance-label')} hidden><span class="toggle-text" id="theme-label">{t(locale, 'nav-theme-dark')}</span><span class="theme-moon"><Icon name="moon" /></span><span class="theme-sun"><Icon name="sun" /></span></button>
      </div>
    </header>
    <slot />
    <dialog class="lightbox" id="lightbox" aria-labelledby="lightbox-title">
      <h2 class="sr-only" id="lightbox-title">{t(locale, 'image-viewer')}</h2>
      <div class="lightbox-stage" id="lightbox-stage">
        <div class="lightbox-media" id="lightbox-media" data-media-state="loading">
          <div id="lightbox-loader" aria-hidden="true"><Skeleton kind="portrait" /><Skeleton kind="certificate" /><Skeleton kind="screenshot" /><Skeleton kind="chart" /></div>
          <img id="lightbox-image" alt="" decoding="async" hidden />
        </div>
        <p class="sr-only" id="lightbox-status" role="status"></p>
      </div>
    </dialog>
    <dialog class="terminal-dialog" id="terminal-dialog" aria-labelledby="terminal-title" aria-describedby="term-intro">
      <div class="terminal-header"><h2 id="terminal-title"><Icon name="terminal" size={18} />{t(locale, 'terminal-title')}</h2><button class="icon-button" id="terminal-close" type="button" aria-label={t(locale, 'close')}><Icon name="close" /></button></div>
      <div class="terminal-body">
        <p id="term-intro">{t(locale, 'term-intro')}</p><div id="term-history"></div>
        <form id="terminal-form"><label class="sr-only" for="term-input">{t(locale, 'terminal-command')}</label><span class="term-prompt" aria-hidden="true">C:\Aaron-Nathanael&gt;</span><input id="term-input" type="text" name="command" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="send" autofocus /></form>
      </div>
      <p class="sr-only" id="terminal-status" role="status"></p>
    </dialog>
    <script is:inline type="application/json" id="site-copy" set:html={json(clientCopy(locale))} />
    <script src="../scripts/main.ts"></script>
  </body>
</html>
