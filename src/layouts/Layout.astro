---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Environment from '../components/Environment.astro';
import bootstrap from '../scripts/bootstrap.js?raw';
import { site } from '../data/site';
import { absoluteUrl, clientCopy, languageNames, locales, routePath, t, type Locale } from '../lib/i18n';
interface Props { locale: Locale; title?: string; description?: string; page?: string; noindex?: boolean }
const { locale, title = t(locale, 'my-name'), description = t(locale, 'site-description'), page = '', noindex = false } = Astro.props;
const canonical = absoluteUrl(noindex ? `${site.base}/404.html` : routePath(locale, page));
const ogLocales = { en: 'en_US', id: 'id_ID', ja: 'ja_JP' };
const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={locale} data-home={!page && !noindex ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ececec" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {!noindex && locales.map(language => <link rel="alternate" hreflang={language} href={absoluteUrl(routePath(language, page))} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={absoluteUrl(routePath('en', page))} />}
    <link rel="icon" type="image/svg+xml" href={`${site.base}/favicon.svg`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${site.base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${site.base}/sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales.filter(language => language !== locale).map(language => <meta property="og:locale:alternate" content={ogLocales[language]} />)}
    <meta property="og:image" content={absoluteUrl(`${site.base}/social-preview.png`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${t(locale, 'my-name')} — ${t(locale, 'site-description')}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(`${site.base}/social-preview.png`)} />
    <script is:inline set:html={bootstrap} />
  </head>
  <body>
    <Environment />
    <a class="skip-link" href="#main-content">{t(locale, 'skip-content')}</a>
    <header class="site-header">
      {page && <a href={routePath(locale)} class="back-link control" aria-label={t(locale, 'back-home')}><Icon name="back" size={18} /><span class="back-full">{t(locale, 'back-home').replace(/^←\s*/, '')}</span><span class="back-short">{t(locale, 'back-short')}</span></a>}
      <div class="floating-controls">
        <details class="lang-dropdown" id="lang-dropdown">
          <summary id="lang-toggle" class="control" aria-label={`${t(locale, 'language-label')} (${languageNames[locale]})`}><span class="locale-code">{locale.toUpperCase()}</span><Icon name="globe" /></summary>
          <div class="lang-menu-track"><nav class="lang-menu" aria-label={t(locale, 'language-label')}>
            {locales.map(language => <a class="lang-option" href={routePath(language, noindex ? '' : page)} lang={language} hreflang={language} aria-current={language === locale ? 'page' : undefined}>{languageNames[language]}</a>)}
          </nav></div>
        </details>
        <button id="theme-toggle" class="control" type="button" aria-label={t(locale, 'appearance-label')} hidden><span class="toggle-text" id="theme-label" data-measure={t(locale, 'nav-theme-light')}>{t(locale, 'nav-theme-dark')}</span><span class="theme-moon"><Icon name="moon" /></span><span class="theme-sun"><Icon name="sun" /></span></button>
      </div>
    </header>
    <slot />
    <dialog class="lightbox" id="lightbox" aria-labelledby="lightbox-title">
      <h2 class="sr-only" id="lightbox-title">{t(locale, 'image-viewer')}</h2>
      <div class="lightbox-stage" id="lightbox-stage">
        <div class="lightbox-media" id="lightbox-media" data-media-state="loading">
          <div id="lightbox-loader" aria-hidden="true"></div>
          <img id="lightbox-image" alt="" decoding="async" hidden />
        </div>
        <p class="sr-only" id="lightbox-status" role="status"></p>
      </div>
    </dialog>
    <script is:inline type="application/json" id="site-copy" set:html={json(clientCopy(locale))} />
    <script src="../scripts/main.ts"></script>
  </body>
</html>
