---
import Skeleton from './Skeleton.astro';
import { t, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<div id="navigation-loader" class="navigation-loader" hidden data-loading-en={t('en', 'page-loading')} data-loading-id={t('id', 'page-loading')} data-loading-ja={t('ja', 'page-loading')} data-error-en={t('en', 'page-error')} data-error-id={t('id', 'page-error')} data-error-ja={t('ja', 'page-error')} data-retry-en={t('en', 'retry')} data-retry-id={t('id', 'retry')} data-retry-ja={t('ja', 'retry')} data-back-en={t('en', 'go-back')} data-back-id={t('id', 'go-back')} data-back-ja={t('ja', 'go-back')}>
  <p id="navigation-status" class="sr-only" role="status">{t(locale, 'page-loading')}</p>
  <div class="navigation-home" aria-hidden="true"><div class="navigation-portrait"><Skeleton /></div><span class="skeleton-block navigation-name"></span><div class="navigation-lines"><i class="skeleton-block"></i><i class="skeleton-block"></i><i class="skeleton-block"></i></div></div>
  <div class="navigation-project section project-detail" aria-hidden="true"><span class="skeleton-block navigation-title"></span><div class="navigation-meta"><i class="skeleton-block"></i><i class="skeleton-block"></i></div><div class="navigation-columns">{[0, 1].map(() => <div class="navigation-lines"><i class="skeleton-block"></i><i class="skeleton-block"></i><i class="skeleton-block"></i><i class="skeleton-block"></i></div>)}</div><div class="navigation-lines"><i class="skeleton-block"></i><i class="skeleton-block"></i></div><div class="navigation-gallery">{[0, 1, 2].map(() => <div><Skeleton /></div>)}</div></div>
  <div id="navigation-error" class="navigation-error" hidden><p id="navigation-error-text"></p><div><button id="navigation-retry" class="control" type="button">{t(locale, 'retry')}</button><button id="navigation-back" class="control" type="button">{t(locale, 'go-back')}</button></div></div>
</div>
