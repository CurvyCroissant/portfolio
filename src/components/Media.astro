---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Skeleton, { type MediaKind } from './Skeleton.astro';
import { t, type Locale } from '../lib/i18n';
interface Props {
  source: ImageMetadata;
  locale: Locale;
  kind: MediaKind;
  alt: string;
  width: number;
  height: number;
  widths: number[];
  sizes: string;
  position?: string;
  eager?: boolean;
}
const { source, locale, kind, alt, width, height, widths, sizes, position = 'center', eager = false } = Astro.props;
---
<span class:list={['media-frame', { 'media-portrait': kind === 'portrait' }]} data-media-state="loading" aria-busy="true" style={`--media-ratio:${width}/${height}`}>
  <Skeleton kind={kind} />
  <Image src={source} alt={alt} width={width} height={height} widths={widths} sizes={sizes} format="webp" fit="cover" position={position} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
  <span class="media-error">{t(locale, 'image-error')}</span>
</span>
