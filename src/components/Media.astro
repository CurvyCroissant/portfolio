---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, type Locale } from '../lib/i18n';
interface Props {
  source: ImageMetadata;
  locale: Locale;
  portrait?: boolean;
  alt: string;
  width: number;
  height: number;
  widths: number[];
  sizes: string;
  position?: string;
  eager?: boolean;
}
const { source, locale, portrait = false, alt, width, height, widths, sizes, position = 'center', eager = false } = Astro.props;
const preview = await getImage({ src: source, width: 32, format: 'webp', quality: 30 });
---
<span class:list={['media-frame', { 'media-portrait': portrait }]} data-media-state="loading" aria-busy="true" style={`--media-ratio:${width}/${height}`}>
  <img class="media-preview" loading={eager ? 'eager' : 'lazy'} decoding="async" src={preview.src} alt="" aria-hidden="true" width={width} height={height} />
  <Image src={source} alt={alt} width={width} height={height} widths={widths} sizes={sizes} format="webp" fit="cover" position={position} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
  <span class="media-error">{t(locale, 'image-error')}</span>
</span>
